# ── Backend services (used by Docker Compose) ────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default in Docker: local PIL (fast). Use pollinations for remote AI backgrounds.
# AD_IMAGE_BACKEND=adverb
# AD_IMAGE_BACKEND=pollinations

# POLLINATIONS_MAX_RETRIES=2
# POLLINATIONS_FAST_429_TO_LOCAL=true

# POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
# POLLINATIONS_RETRY_BASE_SECONDS=1.0
# If Pollinations fails after retries, use local PIL (default on).
# POLLINATIONS_FALLBACK_TO_LOCAL=false

# Optional
# HF_API_TOKEN=
# OPENAI_API_KEY=
# R2_PUBLIC_BASE=   # for decision-engine CDN base when using recommendation-stack profile

# ── Frontend — apps/adpulse (create apps/adpulse/.env.local with these) ──────
# Brand-api is exposed on host port 8800, ad-serving on 8801 (see docker-compose.yml)
# NEXT_PUBLIC_BRAND_API_URL=http://localhost:8800
# NEXT_PUBLIC_AD_SERVING_URL=http://localhost:8801
