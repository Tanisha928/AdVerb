GROQ_API_KEY=your_groq_api_key_here
# Optional override (default: llama-3.3-70b-versatile). See https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Creative image pipeline (brand-api)
# Default: plain studio backgrounds (no remote image API). Set false to use Pollinations for backgrounds.
# AD_PLAIN_BACKGROUND_ONLY=false
# Default image backend when plain mode is off: pollinations. Use "adverb" for local PIL gradients only.
# AD_IMAGE_BACKEND=pollinations
# POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# Optional (legacy / other experiments)
# HF_API_TOKEN=hf_your_token_here
# HF_INFERENCE_ORIGIN=https://router.huggingface.co/hf-inference

# Optional OpenAI/scene integrations
# OPENAI_API_KEY=sk-...
# AD_AI_SCENES=true

# Go decision-engine (docker profile recommendation-stack)
# R2_PUBLIC_BASE=https://your-r2-or-cdn-base
