GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default: Pollinations for AI backgrounds (requires HTTPS egress).
# AD_IMAGE_BACKEND=pollinations
# AD_IMAGE_BACKEND=adverb   # local PIL only, no Pollinations

# POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
# POLLINATIONS_MAX_RETRIES=6
# POLLINATIONS_RETRY_BASE_SECONDS=2.0
# If Pollinations fails after retries (e.g. 429), use local PIL backgrounds (default on).
# POLLINATIONS_FALLBACK_TO_LOCAL=false

# Optional
# HF_API_TOKEN=
# OPENAI_API_KEY=
# R2_PUBLIC_BASE=   # for decision-engine CDN base when using recommendation-stack profile
