GROQ_API_KEY=your_groq_api_key_here
# Optional override (default: llama-3.3-70b-versatile). See https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Hugging Face (free account): https://huggingface.co/settings/tokens — use a token with Inference API access.
# May also set HF_TOKEN instead of HF_API_TOKEN.
HF_API_TOKEN=hf_your_token_here
# Legacy api-inference host is disabled; default is router-backed hf-inference (override only if HF documents a new URL).
# HF_INFERENCE_ORIGIN=https://router.huggingface.co/hf-inference
# Optional OpenAI/scene integrations
# OPENAI_API_KEY=sk-...
# AD_AI_SCENES=true
